<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" colors="true" bootstrap="./Test/Unit/bootstrap.php" cacheDirectory=".phpunit.cache">
  <testsuite name="YourModule Unit Tests">
    <directory suffix="Test.php">./Test/Unit</directory>
  </testsuite>
  <source>
    <include>
      <directory suffix=".php">./</directory>
    </include>
    <exclude>
      <directory>./Test</directory>
    </exclude>
  </source>
</phpunit>
